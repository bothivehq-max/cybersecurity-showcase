#!/usr/bin/env python3
"""Cyber Defense Command Center Dashboard.

A polished security posture summary for a public cybersecurity portfolio project.
"""

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
THREATS_PATH = ROOT / "data" / "threats.json"
CONTROLS_PATH = ROOT / "data" / "controls.json"


def load_json(path: Path):
    with path.open("r", encoding="utf-8") as file:
        return json.load(file)


def compute_security_score(controls, threats):
    score = 100

    identity = controls.get("identity", {})
    endpoint = controls.get("endpoint", {})
    vuln = controls.get("vulnerability_management", {})

    if not identity.get("mfa_required"):
        score -= 12
    if not identity.get("least_privilege"):
        score -= 10
    if not endpoint.get("logging_enabled"):
        score -= 10
    if not vuln.get("patch_cycle"):
        score -= 12

    score -= sum(4 for item in threats if item.get("severity") == "high")
    score -= sum(8 for item in threats if item.get("severity") == "critical")
    return max(0, min(score, 100))


def determine_posture(score):
    if score >= 85:
        return "STRONG"
    if score >= 70:
        return "MODERATE"
    if score >= 50:
        return "WATCHLIST"
    return "CRITICAL"


def main():
    controls = load_json(CONTROLS_PATH)
    threats = load_json(THREATS_PATH)
    score = compute_security_score(controls, threats)
    posture = determine_posture(score)

    print("=== CYBER DEFENSE COMMAND CENTER ===")
    print(f"Security score: {score}/100")
    print(f"Risk posture: {posture}")
    print("\nMission focus:")
    print("  - Identity protection")
    print("  - Endpoint monitoring")
    print("  - Vulnerability management")
    print("  - Incident readiness")
    print("\nThreat summary:")
    for threat in threats:
        print(f"  - {threat['name']} [{threat['severity'].upper()}] : {threat['summary']}")

    print("\nRecommended actions:")
    print("  1. Enforce MFA and review privileged access frequently")
    print("  2. Rotate secrets, tokens, and API keys")
    print("  3. Patch internet-facing systems quickly")
    print("  4. Monitor suspicious authentication and session behavior")
    print("  5. Validate disaster recovery and response playbooks")


if __name__ == "__main__":
    main()
