      <section id="solutions" class="section-block split-panel">
        <div class="container split-layout">
          <div>
            <span class="eyebrow alt">Solutions</span>
            <h2>Private protection for institutions that require clarity and trust.</h2>
          </div>

          <div class="solution-list">
            <div class="solution-item">
              <span>01</span>
              <div>
                <h4>Digital Trust Architecture</h4>
                <p>Build secure systems designed for reliable performance, confidence, and continuity.</p>
              </div>
            </div>
            <div class="solution-item">
              <span>02</span>
              <div>
                <h4>Transaction Security</h4>
                <p>Protect financial and digital flows with disciplined monitoring and layered controls.</p>
              </div>
            </div>
            <div class="solution-item">
              <span>03</span>
              <div>
                <h4>Governance & Assurance</h4>
                <p>Maintain evidence, accountability, and operational readiness for sensitive environments.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="operations" class="section-block">
        <div class="container">
          <div class="section-heading narrow">
            <span class="eyebrow alt">Operational Model</span>
            <h2>Precision across monitoring, defense, and recovery.</h2>
          </div>

          <div class="timeline">
            <div class="timeline-item">
              <span class="time-index">01</span>
              <div>
                <h4>Prepare</h4>
                <p>Validate access, backups, and control design to reduce avoidable exposure.</p>
              </div>
            </div>
            <div class="timeline-item">
              <span class="time-index">02</span>
              <div>
                <h4>Observe</h4>
                <p>Track suspicious patterns, credential anomalies, and unusual access behavior.</p>
              </div>
            </div>
            <div class="timeline-item">
              <span class="time-index">03</span>
              <div>
                <h4>Contain</h4>
                <p>Limit blast radius quickly with structured response and access controls.</p>
              </div>
            </div>
            <div class="timeline-item">
              <span class="time-index">04</span>
              <div>
                <h4>Recover</h4>
                <p>Restore integrity, validate trust, and improve future resilience.</p>
              </div>
