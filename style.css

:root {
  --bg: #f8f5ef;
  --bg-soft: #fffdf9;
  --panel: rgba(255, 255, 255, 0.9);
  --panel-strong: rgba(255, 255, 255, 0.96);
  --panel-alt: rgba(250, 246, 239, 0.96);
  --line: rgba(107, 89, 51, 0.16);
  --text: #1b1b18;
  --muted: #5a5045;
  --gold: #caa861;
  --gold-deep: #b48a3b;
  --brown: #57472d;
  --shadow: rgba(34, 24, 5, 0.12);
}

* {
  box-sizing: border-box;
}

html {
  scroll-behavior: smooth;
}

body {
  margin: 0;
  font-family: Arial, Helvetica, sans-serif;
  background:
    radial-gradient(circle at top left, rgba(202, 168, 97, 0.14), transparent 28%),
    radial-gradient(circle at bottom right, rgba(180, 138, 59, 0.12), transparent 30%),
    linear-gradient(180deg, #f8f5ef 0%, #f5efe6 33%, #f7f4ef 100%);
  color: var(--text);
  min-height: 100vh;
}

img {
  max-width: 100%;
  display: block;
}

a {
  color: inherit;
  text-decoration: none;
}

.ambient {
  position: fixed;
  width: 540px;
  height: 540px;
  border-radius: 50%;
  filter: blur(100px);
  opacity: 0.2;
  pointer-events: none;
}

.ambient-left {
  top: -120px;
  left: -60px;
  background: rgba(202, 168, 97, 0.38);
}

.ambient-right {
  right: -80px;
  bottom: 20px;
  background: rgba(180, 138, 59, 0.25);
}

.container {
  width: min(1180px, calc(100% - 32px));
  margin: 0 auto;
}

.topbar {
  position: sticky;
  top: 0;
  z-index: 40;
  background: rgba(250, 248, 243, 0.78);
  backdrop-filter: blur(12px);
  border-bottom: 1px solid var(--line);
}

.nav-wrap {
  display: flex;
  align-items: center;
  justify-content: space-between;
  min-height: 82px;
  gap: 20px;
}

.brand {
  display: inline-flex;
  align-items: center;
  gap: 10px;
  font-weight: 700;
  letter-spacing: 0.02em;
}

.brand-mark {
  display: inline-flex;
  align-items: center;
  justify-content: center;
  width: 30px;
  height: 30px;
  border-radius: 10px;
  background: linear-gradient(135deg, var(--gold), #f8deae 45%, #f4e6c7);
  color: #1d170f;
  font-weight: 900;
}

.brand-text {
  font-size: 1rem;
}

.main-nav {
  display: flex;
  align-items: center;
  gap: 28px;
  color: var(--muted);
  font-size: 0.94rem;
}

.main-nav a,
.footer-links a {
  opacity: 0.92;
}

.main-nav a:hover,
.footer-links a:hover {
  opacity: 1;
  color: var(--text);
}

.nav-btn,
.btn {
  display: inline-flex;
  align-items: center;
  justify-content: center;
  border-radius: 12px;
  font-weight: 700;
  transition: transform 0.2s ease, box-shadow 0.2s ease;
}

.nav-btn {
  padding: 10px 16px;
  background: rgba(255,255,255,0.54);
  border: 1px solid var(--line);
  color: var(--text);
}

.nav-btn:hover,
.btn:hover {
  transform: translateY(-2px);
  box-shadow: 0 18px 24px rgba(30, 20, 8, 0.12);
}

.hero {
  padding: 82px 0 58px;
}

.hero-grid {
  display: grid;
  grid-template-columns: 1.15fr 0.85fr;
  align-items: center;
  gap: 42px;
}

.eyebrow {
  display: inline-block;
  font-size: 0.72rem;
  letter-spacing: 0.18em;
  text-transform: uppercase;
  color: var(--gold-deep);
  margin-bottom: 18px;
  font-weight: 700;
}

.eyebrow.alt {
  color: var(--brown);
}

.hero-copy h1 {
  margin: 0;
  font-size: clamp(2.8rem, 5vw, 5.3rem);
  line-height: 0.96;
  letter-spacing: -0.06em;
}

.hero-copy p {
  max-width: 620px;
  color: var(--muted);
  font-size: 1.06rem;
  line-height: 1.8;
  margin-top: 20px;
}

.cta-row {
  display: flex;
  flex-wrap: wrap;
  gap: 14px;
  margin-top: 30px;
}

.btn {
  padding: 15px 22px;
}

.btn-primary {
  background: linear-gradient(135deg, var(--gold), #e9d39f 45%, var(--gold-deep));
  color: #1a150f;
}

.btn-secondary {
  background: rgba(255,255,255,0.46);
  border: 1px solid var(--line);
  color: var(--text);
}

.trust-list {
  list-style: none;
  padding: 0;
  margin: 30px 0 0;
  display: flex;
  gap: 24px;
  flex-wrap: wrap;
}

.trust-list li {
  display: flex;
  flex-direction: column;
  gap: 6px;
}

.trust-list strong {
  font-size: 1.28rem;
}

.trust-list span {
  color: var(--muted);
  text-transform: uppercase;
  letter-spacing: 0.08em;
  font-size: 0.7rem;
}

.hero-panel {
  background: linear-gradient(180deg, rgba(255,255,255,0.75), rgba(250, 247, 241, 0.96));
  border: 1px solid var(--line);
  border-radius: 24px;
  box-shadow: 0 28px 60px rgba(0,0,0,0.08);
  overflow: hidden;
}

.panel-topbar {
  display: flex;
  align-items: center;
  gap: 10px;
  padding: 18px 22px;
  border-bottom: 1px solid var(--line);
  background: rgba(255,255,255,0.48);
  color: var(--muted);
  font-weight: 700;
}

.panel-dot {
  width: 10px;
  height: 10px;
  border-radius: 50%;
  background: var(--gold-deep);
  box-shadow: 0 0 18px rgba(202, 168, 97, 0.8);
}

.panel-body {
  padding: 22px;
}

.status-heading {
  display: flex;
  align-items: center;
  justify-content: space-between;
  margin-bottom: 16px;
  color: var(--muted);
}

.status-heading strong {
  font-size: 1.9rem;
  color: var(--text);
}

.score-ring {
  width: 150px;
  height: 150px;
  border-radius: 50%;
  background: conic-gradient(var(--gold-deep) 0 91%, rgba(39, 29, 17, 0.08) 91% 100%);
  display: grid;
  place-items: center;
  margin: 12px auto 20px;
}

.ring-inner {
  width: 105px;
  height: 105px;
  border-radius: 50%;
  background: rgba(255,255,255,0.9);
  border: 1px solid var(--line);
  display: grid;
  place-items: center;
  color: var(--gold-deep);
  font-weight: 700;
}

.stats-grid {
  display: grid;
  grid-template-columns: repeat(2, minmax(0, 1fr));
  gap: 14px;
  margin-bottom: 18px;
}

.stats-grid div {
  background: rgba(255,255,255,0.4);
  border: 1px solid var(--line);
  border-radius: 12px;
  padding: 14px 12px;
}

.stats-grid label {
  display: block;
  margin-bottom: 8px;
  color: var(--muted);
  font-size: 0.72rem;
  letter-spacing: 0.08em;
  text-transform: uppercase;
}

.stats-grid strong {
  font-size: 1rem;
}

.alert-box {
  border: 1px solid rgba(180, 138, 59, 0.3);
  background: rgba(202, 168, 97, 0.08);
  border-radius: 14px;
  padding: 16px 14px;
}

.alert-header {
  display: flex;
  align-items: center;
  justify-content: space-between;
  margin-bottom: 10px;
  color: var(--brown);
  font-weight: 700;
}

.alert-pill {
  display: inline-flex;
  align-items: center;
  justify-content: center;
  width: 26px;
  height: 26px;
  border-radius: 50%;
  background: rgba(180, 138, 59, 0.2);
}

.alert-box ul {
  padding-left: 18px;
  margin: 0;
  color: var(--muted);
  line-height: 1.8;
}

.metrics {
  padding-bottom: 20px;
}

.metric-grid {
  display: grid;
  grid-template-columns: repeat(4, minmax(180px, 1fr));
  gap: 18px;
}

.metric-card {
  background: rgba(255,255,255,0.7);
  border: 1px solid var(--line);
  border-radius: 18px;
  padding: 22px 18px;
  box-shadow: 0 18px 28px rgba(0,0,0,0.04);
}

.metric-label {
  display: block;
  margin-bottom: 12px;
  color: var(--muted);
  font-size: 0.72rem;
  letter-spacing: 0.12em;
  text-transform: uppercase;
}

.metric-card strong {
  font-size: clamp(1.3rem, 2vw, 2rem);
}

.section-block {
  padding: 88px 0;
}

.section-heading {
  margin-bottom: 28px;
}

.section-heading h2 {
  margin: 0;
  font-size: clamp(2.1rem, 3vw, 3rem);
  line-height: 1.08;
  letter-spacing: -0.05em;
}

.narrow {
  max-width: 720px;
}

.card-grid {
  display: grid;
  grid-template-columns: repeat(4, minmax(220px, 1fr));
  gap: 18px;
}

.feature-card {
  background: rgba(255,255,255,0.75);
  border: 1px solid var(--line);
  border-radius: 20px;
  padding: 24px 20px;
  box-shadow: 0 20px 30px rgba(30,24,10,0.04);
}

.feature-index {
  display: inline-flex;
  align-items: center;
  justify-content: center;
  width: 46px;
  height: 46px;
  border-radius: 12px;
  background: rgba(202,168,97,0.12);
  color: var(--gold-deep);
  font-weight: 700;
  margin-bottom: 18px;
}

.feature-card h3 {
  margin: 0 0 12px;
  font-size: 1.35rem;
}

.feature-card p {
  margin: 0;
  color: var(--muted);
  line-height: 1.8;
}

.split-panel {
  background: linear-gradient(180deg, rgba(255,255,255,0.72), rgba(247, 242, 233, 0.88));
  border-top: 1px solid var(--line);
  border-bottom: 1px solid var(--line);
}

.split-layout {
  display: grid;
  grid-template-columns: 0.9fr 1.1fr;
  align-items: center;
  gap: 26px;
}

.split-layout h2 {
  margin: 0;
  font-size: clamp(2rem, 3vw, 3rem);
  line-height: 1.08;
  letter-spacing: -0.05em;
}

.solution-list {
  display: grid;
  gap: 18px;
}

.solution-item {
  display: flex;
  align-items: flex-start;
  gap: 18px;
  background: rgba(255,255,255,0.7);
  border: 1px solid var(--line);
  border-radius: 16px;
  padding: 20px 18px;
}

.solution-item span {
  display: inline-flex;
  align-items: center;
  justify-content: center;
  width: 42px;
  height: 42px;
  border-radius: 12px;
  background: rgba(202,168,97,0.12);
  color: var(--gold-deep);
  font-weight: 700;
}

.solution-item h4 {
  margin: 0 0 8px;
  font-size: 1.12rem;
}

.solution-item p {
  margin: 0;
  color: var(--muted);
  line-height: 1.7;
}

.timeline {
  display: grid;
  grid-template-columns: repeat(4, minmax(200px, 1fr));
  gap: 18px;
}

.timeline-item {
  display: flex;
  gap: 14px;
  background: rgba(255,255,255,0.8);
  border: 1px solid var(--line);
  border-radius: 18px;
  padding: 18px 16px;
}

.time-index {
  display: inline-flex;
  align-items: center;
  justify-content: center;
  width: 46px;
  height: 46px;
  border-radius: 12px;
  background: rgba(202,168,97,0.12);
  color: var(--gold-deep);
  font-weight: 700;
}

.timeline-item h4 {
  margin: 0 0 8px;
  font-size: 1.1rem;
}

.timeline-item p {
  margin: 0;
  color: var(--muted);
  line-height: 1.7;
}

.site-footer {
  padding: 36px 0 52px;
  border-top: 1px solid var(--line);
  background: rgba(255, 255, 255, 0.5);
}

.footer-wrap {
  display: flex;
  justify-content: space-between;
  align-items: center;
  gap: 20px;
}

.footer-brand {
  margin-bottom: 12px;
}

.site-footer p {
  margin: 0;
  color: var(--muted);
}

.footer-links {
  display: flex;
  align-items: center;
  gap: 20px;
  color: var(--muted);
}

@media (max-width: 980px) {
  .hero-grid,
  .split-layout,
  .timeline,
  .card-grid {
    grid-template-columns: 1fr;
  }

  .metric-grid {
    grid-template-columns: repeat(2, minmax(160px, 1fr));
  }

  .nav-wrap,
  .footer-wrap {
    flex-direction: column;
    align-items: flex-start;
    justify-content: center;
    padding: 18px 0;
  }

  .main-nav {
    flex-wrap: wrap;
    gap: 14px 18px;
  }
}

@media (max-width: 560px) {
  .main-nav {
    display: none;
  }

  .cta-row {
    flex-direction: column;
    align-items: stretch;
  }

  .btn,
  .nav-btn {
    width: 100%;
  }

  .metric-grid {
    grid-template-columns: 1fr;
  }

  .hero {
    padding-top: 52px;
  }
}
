            </div>

            <ul class="trust-list">
              <li>
                <strong>24/7</strong>
                <span>monitoring</span>
              </li>
              <li>
                <strong>99.9%</strong>
                <span>resilience</span>
              </li>
              <li>
                <strong>Zero Trust</strong>
                <span>framework</span>
              </li>
            </ul>
          </div>

          <div class="hero-panel" aria-label="Premium security dashboard summary">
            <div class="panel-topbar">
              <span class="panel-dot"></span>
              <span>Command Overview</span>
            </div>

            <div class="panel-body">
              <div class="status-heading">
                <span>Portfolio Score</span>
                <strong>96 / 100</strong>
              </div>

              <div class="score-ring">
                <div class="ring-inner">
                  <span>Secure</span>
                </div>
              </div>

              <div class="stats-grid">
                <div>
                  <label>Threat Visibility</label>
                  <strong>High</strong>
                </div>
                <div>
                  <label>Access Control</label>
                  <strong>Protected</strong>
                </div>
              </div>

              <div class="alert-box">
                <div class="alert-header">
                  <span>Priority Signals</span>
                  <span class="alert-pill">3</span>
                </div>
                <ul>
                  <li>Privileged access review</li>
                  <li>Credential anomaly detection</li>
                  <li>API abuse monitoring</li>
                </ul>
              </div>
            </div>
